# ==============================================================================
# Argos SDK & Application Environment Configuration
# ==============================================================================
# Note: All variables can either be set in this .env file or hardcoded directly
# in the application source code (e.g. src/index.ts).
# ==============================================================================

# Argos Security API Key for authenticating the SDK client
ARGOS_API_KEY=your_argos_api_key_here

# Port on which the Express HTTP server will run
PORT=3001

# Automatic IP/request blocking on threat detection (1 = true, 0 = false)
AUTO_BLOCK_ON_DETECT=1

# Middleware execution mode ('sync' or 'async')
# 'sync'  = Inspect request synchronously before forwarding to route handler
# 'async' = Inspect request asynchronously in the background
ARGOS_MODE=sync
